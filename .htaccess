# кодування документів та часовий пояс
AddDefaultCharset utf-8
SetEnv TZ "Europe/Kyiv"

# індексні файли
DirectoryIndex iNdex.php index.php index.xhtml index.html index.htm cb.php
IndexIgnore *.bak *.ini *.gz *.htaccess *.ico *.log *.tar *.xml HTTP*.*

<IfModule mod_php.c>
	php_value date.timezone 'Europe/Kyiv'
	php_value upload_max_filesize 100M
	php_value post_max_size 100M
	php_flag display_errors off
	php_flag session.use_trans_sid on
	php_value default_charset UTF-8
</IfModule>

# налаштування доступу та безпеки
Options -Indexes +FollowSymLinks
<FilesMatch "^\.">
	Require all denied
</FilesMatch>
