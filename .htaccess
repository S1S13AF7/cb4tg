# кодування документів та часовий пояс
AddDefaultCharset utf-8
SetEnv TZ "Europe/Kyiv"

# індексні файли та приховані розширення
DirectoryIndex iNdex.php index.php index.xhtml index.html index.htm cb.php
IndexIgnore *.bak *.ini *.gz *.htaccess *.ico *.log *.tar *.xml HTTP*.* *.sq* *.db *.tmp

<IfModule mod_php.c>
	php_value date.timezone 'Europe/Kyiv'
	php_value upload_max_filesize 100M
	php_value post_max_size 100M
	php_flag display_errors off
	php_flag session.use_trans_sid on
	php_value default_charset UTF-8
</IfModule>

# налаштування доступу та безпеки
Options -Indexes +FollowSymLinks

# за замовчуванням закриваємо все, окрім кореня теки та дозволених типів
Require all denied

<FilesMatch "(?i)^(?:|.+\.(?:php|xml|x?html?|zip|css|js|jpe?g|jfif|png|gif|webp|svg|ico|bmp|avif|tiff?|heic|heif))$">
	Require all granted
</FilesMatch>

# заборона доступу до прихованих файлів (.htaccess, .git, .env тощо)
<FilesMatch "^\.">
	Require all denied
</FilesMatch>

