# статичні HTML для помилок, коли PHP не може відпрацювати
ErrorDocument 400 /pg/HTTP400.html
ErrorDocument 408 /pg/HTTP408.html
ErrorDocument 413 /pg/HTTP413.html
ErrorDocument 414 /pg/HTTP414.html
ErrorDocument 431 /pg/HTTP431.html
ErrorDocument 500 /pg/HTTP500.html
ErrorDocument 502 /pg/HTTP502.html
ErrorDocument 503 /pg/HTTP503.html
ErrorDocument 504 /pg/HTTP504.html

